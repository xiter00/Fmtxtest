// Fungsi menggambar bitmap format VERTICAL (page-based) secara manual,
// karena Adafruit_GFX drawBitmap() bawaan defaultnya HORIZONTAL.
void drawBitmapVertical(int16_t x, int16_t y, const uint8_t *bitmap,
                         int16_t w, int16_t h, uint16_t color) {
  int16_t pages = (h + 7) / 8;
  for (int16_t page = 0; page < pages; page++) {
    for (int16_t col = 0; col < w; col++) {
      uint8_t line = pgm_read_byte(&bitmap[page * w + col]);
      for (int8_t bit = 0; bit < 8; bit++) {
        int16_t py = page * 8 + bit;
        if (py >= h) break;
        if (line & (1 << bit)) {
          display.drawPixel(x + col, y + py, color);
        }
      }
    }
  }
}

void setup() {
  Wire.begin(SDA_PIN, SCL_PIN);

  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    // OLED gagal init, berhenti di sini
    for (;;) delay(1000);
  }

  display.clearDisplay();

  int16_t x = (SCREEN_WIDTH  - QRIS_W) / 2;
  int16_t y = (SCREEN_HEIGHT - QRIS_H) / 2;

  drawBitmapVertical(x, y, qris_bitmap, QRIS_W, QRIS_H, SSD1306_WHITE);

  display.display();
}

void loop() {
  // Tidak ada apa-apa, gambar statis sudah tampil dari setup()
}
